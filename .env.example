# Copia este archivo como ".env" (sin .example) y completa tus datos reales.
# NUNCA subas el .env a GitHub.

# Token que te da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=pon_aqui_el_token_de_tu_bot

# Archivo JSON de la cuenta de servicio de Google (misma carpeta que main.py)
GOOGLE_CREDENTIALS_FILE=bot-factura.json

# API key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pon_aqui_tu_api_key_de_gemini

# Solo para correr en tu PC (modo polling). En PythonAnywhere NO lo pongas.
SIN_PROXY=1

# Solo para PythonAnywhere (webhook). En tu PC NO lo pongas.
# WEBHOOK_URL_BASE=https://TU_USUARIO.pythonanywhere.com
